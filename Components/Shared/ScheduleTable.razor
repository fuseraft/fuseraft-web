<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Cron</th>
                <th>Next Run (UTC)</th>
                <th>Last Run</th>
                <th>Enabled</th>
                @if (AlertFor is not null) { <th>Notify me of</th> }
                <th></th>
                @if (OnRun is not null) { <th></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Jobs)
            {
                var isDue = job.Due;
                <tr>
                    <td>
                        <span class="mono">@job.Name</span>
                        @if (!string.IsNullOrWhiteSpace(job.Description))
                        {
                            <span class="muted small"> — @job.Description</span>
                        }
                    </td>
                    <td><code class="muted">@job.Cron</code></td>
                    <td class="@(isDue ? "text-warn" : "muted") nowrap">
                        @(job.NextRun?.ToString("MM/dd HH:mm") ?? "—")
                        @if (isDue) { <span class="due-badge">due</span> }
                    </td>
                    <td class="muted nowrap">@(job.LastRun?.ToString("MM/dd HH:mm") ?? "never")</td>
                    <td>
                        <button class="toggle-btn @(job.Enabled ? "toggle-on" : "toggle-off")"
                                @onclick="() => OnToggle?.Invoke((job.Name, !job.Enabled))">
                            @(job.Enabled ? "On" : "Off")
                        </button>
                    </td>
                    @if (AlertFor is not null)
                    {
                        <td>
                            <select class="input alert-select" aria-label="Notify me of @job.Name's runs"
                                    @onchange="e => OnAlert?.Invoke((job.Name, Enum.Parse<ScheduleAlert>((string)e.Value!)))">
                                @foreach (var (alert, label) in AlertLabels)
                                {
                                    <option value="@alert" selected="@(AlertFor(job.Name) == alert)">@label</option>
                                }
                            </select>
                        </td>
                    }
                    <td>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => OnRemove?.Invoke(job.Name)">
                            Remove
                        </button>
                    </td>
                    @if (OnRun is not null)
                    {
                        <td>
                            <button class="btn btn-sm btn-primary" title="Start the job now as a live session. Its schedule doesn't change."
                                    @onclick="() => OnRun(job.Name)">
                                Run
                            </button>
                        </td>
                    }
                </tr>
            }
            @if (!Jobs.Any())
            {
                <tr>
                    <td colspan="@(6 + (OnRun is not null ? 1 : 0) + (AlertFor is not null ? 1 : 0))" class="empty-row">
                        No scheduled jobs. Click "+ Add Job" or use <code>fuseraft schedule add</code>.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IEnumerable<WireScheduledJob> Jobs { get; set; } = [];
    [Parameter] public Action<string>?            OnRemove { get; set; }
    [Parameter] public Action<(string Name, bool Enabled)>? OnToggle { get; set; }
    [Parameter] public Action<string>?            OnRun  { get; set; }
    [Parameter] public Func<string, ScheduleAlert>? AlertFor { get; set; }
    [Parameter] public Action<(string Name, ScheduleAlert Alert)>? OnAlert { get; set; }

    public static readonly (ScheduleAlert Alert, string Label)[] AlertLabels =
    [
        (ScheduleAlert.Failures, "Failures"), (ScheduleAlert.Successes, "Successes"),
        (ScheduleAlert.Both, "Both"), (ScheduleAlert.Off, "Nothing"),
    ];
}
