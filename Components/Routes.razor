@inject NavigationManager Nav
@inject IJSRuntime JS

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <div class="page-header"><h1>Admins only</h1></div>
                <p class="muted">That page is for admins. Ask one if you need something there.</p>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found — Fuseraft</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="page-header"><h1>Not found</h1></div>
            <p class="muted">There's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // A link followed while this circuit was connecting changed the browser's address but not this router's,
    // which still shows the page the circuit started at. Catch up with the browser.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        string address;
        try { address = await JS.InvokeAsync<string>("fuseraftAddress"); }
        catch (JSDisconnectedException) { return; }
        if (!string.Equals(WithoutFragment(address), WithoutFragment(Nav.Uri), StringComparison.Ordinal))
            Nav.NavigateTo(address, replace: true);
    }

    private static string WithoutFragment(string uri) => uri.Split('#')[0];
}
