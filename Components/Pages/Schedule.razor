@page "/schedule"
@inject ScheduleService ScheduleService
@inject SessionHostService SessionService
@inject NavigationManager Nav
@inject UserStore Users

<PageTitle>Schedule — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Scheduled Jobs</h1>
    <button class="btn btn-primary" @onclick="() => { _showAdd = true; _addError = null; }">+ Add Job</button>
</div>

@if (_showAdd)
{
    <div class="dialog-backdrop" @onclick="CloseAdd">
        <div class="dialog" @onclick:stopPropagation>
            <div class="dialog-header">
                <h2>Add Scheduled Job</h2>
                <button class="btn-icon" @onclick="CloseAdd">✕</button>
            </div>
            <div class="form-group">
                <label class="form-label">Job Name</label>
                <input @bind="_addName" class="input" placeholder="nightly-audit" />
            </div>
            <div class="form-group">
                <label class="form-label">Cron Expression</label>
                <input @bind="_addCron" class="input" placeholder="0 2 * * *" />
                <p class="form-hint">5-field cron. E.g. <code>0 2 * * *</code> = 2 AM UTC daily.</p>
            </div>
            <div class="form-group">
                <label class="form-label">Task</label>
                <textarea @bind="_addTask" rows="3" class="input"
                          placeholder="Task description passed to the agent team…"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Config Path <span class="form-optional">(optional)</span></label>
                <input @bind="_addConfig" class="input" placeholder=".fuseraft/config/orchestration.yaml" />
            </div>
            <div class="form-group">
                <label class="form-label">Working Directory <span class="form-optional">(optional)</span></label>
                <input @bind="_addWorkDir" class="input" placeholder="/path/to/project" />
            </div>
            <div class="form-group">
                <label class="form-label">Description <span class="form-optional">(optional)</span></label>
                <input @bind="_addDesc" class="input" placeholder="Short description…" />
            </div>
            <div class="form-group">
                <label class="form-label">Notify me of</label>
                <select @bind="_addAlert" class="input">
                    @foreach (var (alert, label) in ScheduleTable.AlertLabels)
                    {
                        <option value="@alert">@label</option>
                    }
                </select>
                <p class="form-hint">Runs that fail, succeed, or both: in your open tabs, and by email if you get it.</p>
            </div>
            @if (_addError is not null)
            {
                <div class="error-banner">@_addError</div>
            }
            <div class="dialog-footer">
                <button class="btn" @onclick="CloseAdd">Cancel</button>
                <button class="btn btn-primary" @onclick="AddAsync" disabled="@_adding">
                    @(_adding ? "Adding…" : "Add Job")
                </button>
            </div>
        </div>
    </div>
}

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}

<ScheduleTable Jobs="@_jobs"
               OnRemove="@RemoveJob"
               OnToggle="@HandleToggle"
               OnRun="@RunJob"
               AlertFor="@AlertFor"
               OnAlert="@SetAlert" />

@code {
    private List<WireScheduledJob> _jobs = [];
    private bool   _showAdd = false;
    private bool   _adding  = false;
    private string _addName = string.Empty;
    private string _addCron = string.Empty;
    private string _addTask = string.Empty;
    private string _addConfig = string.Empty;
    private string _addDesc = string.Empty;
    private string _addWorkDir = string.Empty;
    private ScheduleAlert _addAlert;
    private string? _addError;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadJobsAsync();

    private async Task LoadJobsAsync()
    {
        try { _jobs = await ScheduleService.GetJobsAsync(); }
        catch (FuseraftCliException ex) { _error = ex.Message; }
    }

    private void CloseAdd()
    {
        _showAdd = false;
        _addError = null;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_addName)) { _addError = "Name is required.";          return; }
        if (string.IsNullOrWhiteSpace(_addCron)) { _addError = "Cron expression is required."; return; }
        if (string.IsNullOrWhiteSpace(_addTask)) { _addError = "Task is required.";           return; }

        _adding   = true;
        _addError = null;
        StateHasChanged();

        try
        {
            await ScheduleService.AddJobAsync(_addName, _addCron, _addTask, _addConfig, _addDesc, _addWorkDir);
            SetAlert((_addName, _addAlert));
            _showAdd = false;
            (_addName, _addCron, _addTask, _addConfig, _addDesc, _addWorkDir, _addAlert) = ("", "", "", "", "", "", default);
            await LoadJobsAsync();
        }
        catch (Exception ex) { _addError = ex.Message; }
        finally { _adding = false; }
    }

    private void RemoveJob(string name) => _ = InvokeAsync(() => ChangeAsync(async () =>
    {
        await ScheduleService.RemoveJobAsync(name);
        Users.Update(Current.User.Id, u => u.ScheduleAlerts.Remove(name));
    }));

    private ScheduleAlert AlertFor(string name) => (Users.Find(Current.User.Id) ?? Current.User).AlertFor(name);

    // Failures is what a job no one chose for gets, so it's left out of users.json.
    private void SetAlert((string Name, ScheduleAlert Alert) args) => Users.Update(Current.User.Id, u =>
    {
        if (args.Alert == default) u.ScheduleAlerts.Remove(args.Name);
        else u.ScheduleAlerts[args.Name] = args.Alert;
    });

    private void HandleToggle((string Name, bool Enabled) args) =>
        _ = InvokeAsync(() => ChangeAsync(() => ScheduleService.SetEnabledAsync(args.Name, args.Enabled)));

    private async Task ChangeAsync(Func<Task> change)
    {
        _error = null;
        try { await change(); }
        catch (FuseraftCliException ex) { _error = ex.Message; }
        await LoadJobsAsync();
        StateHasChanged();
    }

    private void RunJob(string name) => _ = InvokeAsync(() => RunJobAsync(name));

    // Runs attended, with approvals, unlike 'fuseraft schedule run'; the job's LastRun/NextRun stay as they are.
    private async Task RunJobAsync(string name)
    {
        _error = null;
        var job = _jobs.FirstOrDefault(j => j.Name == name);
        if (job is null) return;

        try
        {
            var sessionId = await SessionService.StartSessionAsync(Current.User, 
                job.Task,
                job.Config ?? ".fuseraft/config/orchestration.yaml",
                job.WorkDir ?? string.Empty);
            Nav.NavigateTo($"/sessions/{sessionId}");
        }
        catch (Exception ex)
        {
            _error = $"Failed to run '{name}': {ex.Message}";
            StateHasChanged();
        }
    }
}
