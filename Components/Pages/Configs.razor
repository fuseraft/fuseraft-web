@page "/configs"
@implements IDisposable
@inject ConfigService ConfigService
@inject WorkspaceService WorkspaceService
@inject IJSRuntime JS

<PageTitle>Configs — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Config Files</h1>
</div>

<div class="form-group" style="max-width:680px">
    <label class="form-label">Directory or File Path</label>
    <div class="input-with-btn">
        <input @bind="_path" @bind:event="oninput" class="input"
               placeholder="/path/to/project or /path/to/config.yaml" />
        <button class="btn btn-sm" @onclick="TogglePicker">Browse…</button>
        <button class="btn btn-sm btn-primary" @onclick="SearchAsync">Scan</button>
    </div>
    @if (_showPicker)
    {
        <DirPicker InitialPath="@_path" OnSelect="OnDirSelected" OnClose="() => _showPicker = false" />
    }
</div>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}

@if (_scanning)
{
    <p class="muted">Scanning…</p>
}
else if (_configs is not null)
{
    @if (_configs.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🗂</div>
            <p>No config files found.</p>
            <p class="muted">Only <code>.yaml</code>, <code>.yml</code>, and <code>.json</code> files are scanned.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper" style="margin-bottom:1.5rem">
            <table class="data-table config-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Name</th>
                        <th>Agents</th>
                        <th>Flow</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cfg in _configs)
                    {
                        <tr class="@(_selected?.Path == cfg.Path ? "row-selected" : "clickable")"
                            @onclick="() => SelectConfig(cfg.Path)">
                            <td class="mono small">@cfg.Path</td>
                            <td>
                                @if (cfg.NeedsMigration)
                                {
                                    <span class="text-warning" title="@cfg.Error">old format</span>
                                }
                                else if (cfg.Error is not null)
                                {
                                    <span class="text-danger" title="@cfg.Error">doesn't load</span>
                                }
                                else
                                {
                                    @cfg.Name
                                }
                            </td>
                            <td class="muted small">@(cfg.Error is null ? string.Join(", ", cfg.Agents) : "—")</td>
                            <td class="muted">@cfg.Flow</td>
                            <td class="config-row-actions">
                                <button class="btn btn-sm" @onclick:stopPropagation
                                        @onclick="() => EditAsync(cfg)">
                                    Edit
                                </button>
                                <button class="btn btn-sm" @onclick:stopPropagation
                                        @onclick="() => ValidateConfigAsync(cfg.Path)">
                                    Validate
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_editing is not null)
{
    <div class="config-validate-panel">
        <div class="config-validate-header">
            <h2>Edit @(_editing.Name ?? Path.GetFileName(_editing.Path))</h2>
        </div>
        <ConfigEditor @ref="_editor" TeamFile="@_editing.Path" AgentFiles="@_editing.AgentFiles" OnSaved="OnEditorSaved" OnClose="() => _editing = null" />
    </div>
}

@if (_migrated is not null)
{
    <div class="config-migrated">
        <p class="text-success">✓ Converted <span class="mono small">@_migrated.Value.Path</span> to a team file.</p>
        @if (_migrated.Value.Notes.Count > 0)
        {
            <ul class="muted small">
                @foreach (var note in _migrated.Value.Notes) { <li>@note</li> }
            </ul>
        }
    </div>
}

@if (_validating)
{
    <p class="muted">Validating…</p>
}
else if (_validation is not null)
{
    <div class="config-validate-panel">
        <div class="config-validate-header">
            <h2>@(_validation.Config?.Name ?? "Validation") — @(_validation.Valid ? "✓ Valid" : "✗ Invalid")</h2>
            <span class="muted small">@_validation.Path</span>
        </div>

        @if (_validation.Config is { } s)
        {
            <div class="config-details">
                @if (!string.IsNullOrWhiteSpace(s.Description))
                {
                    <p class="muted">@s.Description</p>
                }
                <div class="config-agents">
                    @foreach (var a in s.Agents)
                    {
                        <span class="agent-chip">@a</span>
                    }
                </div>
                <p class="muted small">Flow: <strong>@s.Flow</strong></p>
            </div>
        }

        @if (_validation.NeedsMigration)
        {
            <div class="config-migrate">
                <p>This file is in a format fuseraft no longer runs. <code>fuseraft migrate</code> can convert it to a team file.</p>
                @if (_confirmMigrate)
                {
                    <p class="muted small">This overwrites the file in place, and writes a markdown file for each agent that used <code>agentFile</code>. Comments inside the file aren't kept; the leading comment block is.</p>
                    <button class="btn btn-sm btn-primary" @onclick="() => MigrateAsync(_validation.Path)" disabled="@_migrating">
                        @(_migrating ? "Converting…" : "Convert")
                    </button>
                    <button class="btn btn-sm" @onclick="() => _confirmMigrate = false" disabled="@_migrating">Cancel</button>
                }
                else
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => _confirmMigrate = true">Migrate…</button>
                }
            </div>
        }

        @if (_validation.Issues.Count == 0)
        {
            <p class="text-success">No issues found.</p>
        }
        else
        {
            <ul class="issue-list">
                @foreach (var issue in _validation.Issues)
                {
                    <li class="issue-@issue.Level">
                        <span class="issue-icon">@(issue.Level == "error" ? "✗" : "⚠")</span>
                        @issue.Message
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    private string  _path       = string.Empty;
    private bool    _showPicker = false;

    /// <summary>A team file to open in the editor, as the builder links it.</summary>
    [SupplyParameterFromQuery(Name = "edit")] public string? EditPath { get; set; }

    private WireConfigSummary? _editing;
    private ConfigEditor? _editor;

    protected override void OnInitialized()
    {
        _path = PreferFuseraftConfigDir(WorkspaceService.Current);
        if (RendererInfo.IsInteractive) WorkspaceService.Changed += OnWorkspaceChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive || string.IsNullOrWhiteSpace(EditPath)) return;
        _path = Path.GetDirectoryName(EditPath) ?? _path;
        await SearchAsync();
        var target = Path.GetFullPath(EditPath);
        if (_configs?.FirstOrDefault(c => c.Path == target) is { } cfg) Edit(cfg);
        else if (_error is null) _error = $"{EditPath} isn't a config file in {_path}.";
    }

    private async Task EditAsync(WireConfigSummary cfg)
    {
        if (_editing?.Path != cfg.Path && _editor?.HasUnsavedChanges == true
            && !await JS.InvokeAsync<bool>("confirm", $"Discard your unsaved changes to {_editing?.Name ?? "this team"}?"))
            return;
        Edit(cfg);
    }

    private void Edit(WireConfigSummary cfg)
    {
        _editing = cfg;
        _selected = cfg;
        _validation = null;
    }

    /// <summary>A validation's summary row, also for a team that doesn't load, with the agent files it names.</summary>
    private static WireConfigSummary Summary(WireValidation v) =>
        (v.Config ?? new WireConfigSummary
        {
            Path  = v.Path,
            Error = v.Issues.FirstOrDefault(i => i.Level == "error")?.Message ?? "Doesn't load.",
        }) with { AgentFiles = v.AgentFiles.Count > 0 ? v.AgentFiles : v.Config?.AgentFiles ?? [] };

    private void OnEditorSaved(WireValidation? result)
    {
        if (result is null || _editing is null) return;
        var fresh = Summary(result);
        _editing = fresh;
        if (_configs is not null) _configs = [.. _configs.Select(c => c.Path == fresh.Path ? fresh : c)];
    }

    private void OnWorkspaceChanged() =>
        InvokeAsync(() => { _path = PreferFuseraftConfigDir(WorkspaceService.Current); StateHasChanged(); });

    private static string PreferFuseraftConfigDir(string workspace)
    {
        if (string.IsNullOrWhiteSpace(workspace)) return workspace;
        var sub = Path.Combine(workspace, ".fuseraft", "config");
        return Directory.Exists(sub) ? sub : workspace;
    }

    public void Dispose() => WorkspaceService.Changed -= OnWorkspaceChanged;
    private bool    _scanning   = false;
    private bool    _validating = false;
    private bool    _migrating  = false;
    private bool    _confirmMigrate = false;
    private string? _error;
    private (string Path, IReadOnlyList<string> Notes)? _migrated;

    private List<WireConfigSummary>? _configs    = null;
    private WireConfigSummary?       _selected   = null;
    private WireValidation?          _validation = null;

    private void TogglePicker() { _showPicker = !_showPicker; }

    private async Task OnDirSelected(string path)
    {
        _path       = path;
        _showPicker = false;
        WorkspaceService.Set(path);
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_path)) return;
        var trimmed = _path.Trim();
        WorkspaceService.Set(trimmed);

        _scanning   = true;
        _error      = null;
        _validation = null;
        _selected   = null;
        StateHasChanged();

        try
        {
            if (File.Exists(trimmed))
            {
                await ValidateConfigAsync(trimmed);
                _configs = [_validation is null ? new WireConfigSummary { Path = Path.GetFullPath(trimmed), Error = "Doesn't load." } : Summary(_validation)];
                _selected = _configs[0];
            }
            else
            {
                _configs = await ConfigService.ListConfigsAsync(trimmed);
            }
        }
        catch (FuseraftCliException ex)
        {
            _configs = null;
            _error   = ex.Message;
        }
        finally { _scanning = false; StateHasChanged(); }
    }

    private void SelectConfig(string path)
    {
        _selected = _configs?.FirstOrDefault(c => c.Path == path);
        StateHasChanged();
    }

    private async Task ValidateConfigAsync(string path)
    {
        _validating = true;
        _error      = null;
        _confirmMigrate = false;
        if (_migrated?.Path != path) _migrated = null;
        StateHasChanged();
        try
        {
            _validation = await ConfigService.ValidateAsync(path);
            _selected   = _configs?.FirstOrDefault(c => c.Path == path);
        }
        catch (FuseraftCliException ex) { _validation = null; _error = ex.Message; }
        finally { _validating = false; StateHasChanged(); }
    }

    private async Task MigrateAsync(string path)
    {
        _migrating = true;
        _error     = null;
        StateHasChanged();
        try
        {
            _migrated = (path, await ConfigService.MigrateAsync(path));
            await ValidateConfigAsync(path);
            if (_configs is not null && _validation?.Config is { } fresh)
                _configs = [.. _configs.Select(c => c.Path == fresh.Path ? fresh : c)];
        }
        catch (Exception ex) when (ex is FuseraftCliException or UnauthorizedAccessException) { _error = ex.Message; }
        finally { _migrating = false; _confirmMigrate = false; StateHasChanged(); }
    }
}
