@page "/chat"
@implements IDisposable
@using System.Text.Json
@inject ReplService ReplService
@inject ModelProfileService ProfileService
@inject HitlBroker Broker
@inject WorkspaceService WorkspaceService
@inject WorkspaceAccess Access
@inject ModelCatalogService Catalog
@inject IJSRuntime JS

<PageTitle>Chat — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Chat</h1>
    @if (_activeSessionId is not null)
    {
        <button class="btn" @onclick="CloseSession">← New Chat</button>
    }
</div>

@if (_pageError is not null)
{
    <div class="error-banner">@_pageError</div>
}

@if (_activeSessionId is null)
{
    @if (_profiles.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">⊙</div>
            <p>No model profiles configured.</p>
            <p class="muted">Add a profile in <a href="/model-profiles">Profiles</a> to get started.</p>
        </div>
    }
    else
    {
        <div class="repl-start">
            <div class="form-group">
                <label class="form-label">Model Profile</label>
                <select class="input" @bind="_selectedProfileId">
                    @foreach (var p in _profiles)
                    {
                        <option value="@p.Id">@p.Name — @p.ModelId</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Workspace</label>
                <div class="input-with-btn">
                    <input class="input" @bind="_workspace" @bind:event="oninput" @bind:after="() => _missingWorkspace = null"
                           placeholder="/home/user/myproject" />
                    <button class="btn btn-sm" type="button" @onclick="() => _showPicker = !_showPicker">Browse…</button>
                </div>
                @if (_showPicker)
                {
                    <DirPicker InitialPath="@_workspace" OnSelect="OnDirSelected" OnClose="() => _showPicker = false" />
                }
                @if (_missingWorkspace is { } missing)
                {
                    <div class="callout callout-warn">
                        <span><code>@missing</code> doesn't exist yet.</span>
                        <button class="btn btn-sm btn-primary" @onclick="CreateWorkspaceAndStartAsync" disabled="@_starting">Create it and start</button>
                        <button class="btn btn-sm" @onclick="() => _missingWorkspace = null">Cancel</button>
                    </div>
                }
                <p class="form-hint">The chat's files and commands are confined to this directory, and it asks before writing or running anything.</p>
            </div>
            <div class="form-group">
                <label class="form-label">System Prompt <span class="muted small">(optional)</span></label>
                <textarea class="input repl-sysprompt"
                          @bind="_systemPrompt" @bind:event="oninput"
                          placeholder="You are a helpful assistant."
                          rows="3"></textarea>
            </div>
            <div>
                <button class="btn btn-primary" @onclick="StartSessionAsync" disabled="@_starting">
                    @(_starting ? "Starting…" : "Start Chat")
                </button>
            </div>
        </div>

        @if (_snapshots.Count > 0)
        {
            <div class="repl-history">
                <h2>Recent Chats</h2>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Chat</th>
                                <th>Model</th>
                                <th>Turns</th>
                                <th>Last Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var snap in _snapshots)
                            {
                                <tr>
                                    <td class="mono small">@snap.SessionId</td>
                                    <td class="small" title="@snap.Cwd">@Truncate(snap.DisplayName, 60)</td>
                                    <td class="small muted">@snap.ModelId</td>
                                    <td class="small muted">@snap.TurnIndex</td>
                                    <td class="small muted">@snap.LastUpdatedAt.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm"
                                                @onclick="() => ResumeSnapshotAsync(snap.SessionId)">
                                            Resume
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
else
{
    var session = ReplService.GetSession(Current.User, _activeSessionId!);
    if (session is null)
    {
        <p class="muted">Chat not found.</p>
    }
    else
    {
        var transcript = session.Transcript();
        var busy       = session.Status == ReplStatus.Thinking;
        <div class="repl-view">
            <div class="repl-session-bar">
                <code class="repl-session-id">@session.SessionId</code>
                <button class="btn btn-sm btn-ghost repl-model-btn @(_panel == "model" ? "active" : "")"
                        title="Switch this chat's model" @onclick='() => TogglePanel("model")'>@session.ModelId ▾</button>
                @if (session.Cwd is { Length: > 0 } cwd)
                {
                    <span class="muted small mono repl-session-cwd" title="@cwd">@(Path.GetFileName(cwd.TrimEnd('/', '\\')) is { Length: > 0 } dir ? dir : cwd)</span>
                }
                @if (session.StatusLine is { } status)
                {
                    <span class="repl-ctx repl-ctx-@status.Level" title="@ContextTitle(status)">@ContextLabel(status)</span>
                }
                @if (busy)
                {
                    <span class="muted small repl-busy">@(session.StreamingTools is { } running ? $"⚙ {LastTool(running)}" : "thinking…")</span>
                }
                <div class="repl-session-actions">
                    @if (session.Tools is { } chatTools)
                    {
                        <button class="btn btn-sm @(_panel == "tools" ? "active" : "")" aria-expanded="@(_panel == "tools" ? "true" : "false")"
                                title="Choose the tools this chat can use" @onclick='() => TogglePanel("tools")'>
                            Tools <span class="muted">@ActiveCount(chatTools)/@chatTools.Categories.Sum(c => c.Tools?.Count ?? 0)</span>
                        </button>
                    }
                    @if (session.ChangedFiles.Count > 0)
                    {
                        <button class="btn btn-sm @(_panel == "changes" ? "active" : "")" title="Files this chat changed"
                                @onclick='() => TogglePanel("changes")'>
                            Changes <span class="muted">@session.ChangedFiles.Count</span>
                        </button>
                    }
                    <button class="btn btn-sm" title="Download this chat as Markdown" @onclick="ExportAsync">Export</button>
                    <button class="btn btn-sm" title="Start a new chat (this one stays in Recent Chats)" @onclick="Clear" disabled="@busy">Clear</button>
                    <button class="btn btn-sm" @onclick="CloseSession">Close</button>
                </div>
            </div>

            @if (_panel == "tools" && session.Tools is { } menu)
            {
                <section class="repl-tools" aria-label="Tools">
                    <div class="repl-tools-head">
                        <h2>Tools</h2>
                        <span class="muted small">@ActiveCount(menu) of @menu.Categories.Sum(c => c.Tools?.Count ?? 0) on in this chat</span>
                        <button class="btn btn-sm" style="margin-left:auto" @onclick="() => _panel = null">Close</button>
                    </div>
                    @if (menu.SafeMode)
                    {
                        <p class="form-hint">Safe mode is on: Shell, Git and Http stay off until <code>/safe-mode off</code>.</p>
                    }
                    @if (busy)
                    {
                        <p class="form-hint">You can change tools once the reply finishes.</p>
                    }
                    <input class="input repl-tools-filter" type="search" placeholder="Filter tools" aria-label="Filter tools"
                           @bind="_toolsQuery" @bind:event="oninput" />
                    <div class="repl-tools-list">
                        <ToolSwitches Categories="menu.Categories" Query="@_toolsQuery" Chat="true"
                                      Disabled="@(busy || session.ToolsChanging)" OnToggle="ToggleTool" />
                    </div>
                    <div class="repl-tools-foot">
                        <span class="muted small">@(menu.MatchesDefaults ? "New chats start with these tools." : "New chats start with your saved defaults.")</span>
                        <button class="btn btn-sm" disabled="@(menu.MatchesDefaults || busy || session.ToolsChanging)"
                                title="Start new chats with the tools on now" @onclick='() => ChangeTools("save")'>Save as default</button>
                        <button class="btn btn-sm" disabled="@(menu.MatchesDefaults || busy || session.ToolsChanging)"
                                title="Go back to the tools new chats start with" @onclick='() => ChangeTools("reset")'>Reset</button>
                    </div>
                </section>
            }

            @if (_panel == "model")
            {
                <section class="repl-tools" aria-label="Model">
                    <div class="repl-tools-head">
                        <h2>Model</h2>
                        <span class="muted small">Switches this chat with <code>/model</code>; the profile's key and endpoint stay.</span>
                        <button class="btn btn-sm" style="margin-left:auto" @onclick="() => _panel = null">Close</button>
                    </div>
                    <div class="input-with-btn">
                        <input class="input" @bind="_modelQuery" @bind:event="oninput" placeholder="Filter, or type any model ID"
                               aria-label="Model ID" @onkeydown="OnModelKeyDown" />
                        <button class="btn btn-sm btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(_modelQuery))"
                                @onclick="() => SwitchModel(_modelQuery)">Switch</button>
                    </div>
                    @if (_modelsError is not null)
                    {
                        <p class="form-hint form-hint-error">@_modelsError</p>
                    }
                    else if (_models is null)
                    {
                        <p class="form-hint">Asking the provider for its models…</p>
                    }
                    <div class="repl-model-list">
                        @foreach (var m in (_models ?? []).Where(m => m.Contains(_modelQuery.Trim(), StringComparison.OrdinalIgnoreCase)).Take(200))
                        {
                            <button class="repl-model-item @(m == session.ModelId ? "current" : "")" disabled="@busy"
                                    @onclick="() => SwitchModel(m)">@m</button>
                        }
                    </div>
                </section>
            }

            @if (_panel == "changes")
            {
                <section class="repl-tools" aria-label="Changed files">
                    <div class="repl-tools-head">
                        <h2>Changes</h2>
                        <span class="muted small">Files this chat changed. A diff shows everything not yet committed.</span>
                        <button class="btn btn-sm" style="margin-left:auto" @onclick="() => _panel = null">Close</button>
                    </div>
                    <div class="repl-changes">
                        @foreach (var change in session.ChangedFiles.AsEnumerable().Reverse().ToList())
                        {
                            <div class="repl-change-row">
                                <button class="repl-change @(_diffAt is null && _diffPath == change.Path ? "active" : "")" @onclick="() => ShowDiffAsync(change.Path, null)">
                                    <span class="repl-change-sigil sigil-@SigilClass(change.Sigil)">@change.Sigil</span>
                                    <span class="mono">@change.Path</span>
                                    @if (change.Added + change.Removed > 0)
                                    {
                                        <span class="repl-change-counts"><span class="added">+@change.Added</span> <span class="removed">−@change.Removed</span></span>
                                    }
                                </button>
                                @if (_diffAt is null && _diffPath == change.Path)
                                {
                                    @if (_diff is not null) { <DiffView Diff="@_diff" /> }
                                    else { <p class="form-hint">@(_diffReason ?? "Loading the diff…")</p> }
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            @if (session.Error is not null)
            {
                <div class="error-banner">@session.Error</div>
            }

            <div class="repl-transcript">
                @if (transcript.Length == 0 && !busy)
                {
                    <div class="repl-welcome">
                        <p>
                            @if (session.Cwd is { Length: > 0 } home)
                            {
                                <text>Ask about the code in <code title="@home">@(Path.GetFileName(home.TrimEnd('/', '\\')) is { Length: > 0 } folder ? folder : home)</code>, or have it make changes; it asks before writing files or running commands.</text>
                            }
                            else
                            {
                                <text>Ask anything. With no workspace, it can't read or change files.</text>
                            }
                        </p>
                        <ul class="repl-welcome-tips">
                            @if (session.Commands.Count > 0)
                            {
                                <li><kbd>/</kbd> opens the command menu, and <a href="" @onclick='() => SendNow("/help")' @onclick:preventDefault>/help</a> lists every command.</li>
                            }
                            else
                            {
                                <li><a href="" @onclick='() => SendNow("/help")' @onclick:preventDefault>/help</a> lists every slash command.</li>
                            }
                            @if (session.Cwd is not null)
                            {
                                <li><kbd>@@</kbd> points at a file or folder, which goes along with your message.</li>
                            }
                            <li><kbd>!</kbd> runs a shell command yourself, such as <code>!git status</code>.</li>
                            <li>Attach or paste images for a model that can see them.</li>
                        </ul>
                        <div class="repl-starters">
                            @foreach (var (label, prompt) in Starters(session))
                            {
                                <button class="btn btn-sm" @onclick="() => _input = prompt">@label</button>
                            }
                            @if (LastChatHere(session) is { } last)
                            {
                                <button class="btn btn-sm" title="Close this empty chat and resume that one"
                                        @onclick="() => ContinueAsync(last.SessionId)">Continue “@Truncate(last.DisplayName, 40)”</button>
                            }
                        </div>
                    </div>
                }

                @foreach (var msg in transcript)
                {
                    @switch (msg.Role)
                    {
                        case "shell":
                            var run = msg.Parts.OfType<ReplShellPart>().FirstOrDefault();
                            <div class="repl-shell">
                                <div class="repl-shell-cmd">$ @msg.Text @if (run is { Done: false }) { <span class="muted small">running…</span> }</div>
                                @if (run is { Output.Length: > 0 })
                                {
                                    <pre class="repl-shell-out">@run.Output</pre>
                                }
                            </div>
                            break;
                        case "system":
                            <div class="repl-msg repl-msg-system @(msg.Tone is { } tone ? $"repl-tone-{tone}" : "") @(msg.Replayed ? "repl-replayed" : "")">
                                <Markdown Text="@msg.Text" />
                            </div>
                            break;
                        default:
                            <div class="repl-msg repl-msg-@msg.Role @(msg.Replayed ? "repl-replayed" : "")">
                                <div class="repl-msg-role">
                                    @(msg.Role == "user" ? "You" : "Assistant")
                                    @if (msg.Queued) { <span class="repl-queued" title="Sent while a reply was running; it joins that reply or starts the next">queued</span> }
                                </div>
                                @if (msg.Role == "assistant")
                                {
                                    @if (msg.Parts.Count > 0)
                                    {
                                        <ReplParts Parts="msg.Parts" />
                                    }
                                    else
                                    {
                                        <Markdown Text="@msg.Text" />
                                        @if (msg.ToolCalls.Count > 0)
                                        {
                                            <div class="repl-tool-chips">
                                                @foreach (var tool in msg.ToolCalls)
                                                {
                                                    <span class="tool-call-chip"><span class="tool-call-name">@tool</span></span>
                                                }
                                            </div>
                                        }
                                    }
                                    @if (msg.Changes.Count > 0)
                                    {
                                        <div class="repl-msg-changes">
                                            @foreach (var change in msg.Changes)
                                            {
                                                <button class="repl-change-chip @(_diffAt == msg && _diffPath == change.Path ? "active" : "")"
                                                        title="Show the diff" @onclick="() => ShowDiffAsync(change.Path, msg)">
                                                    <span class="sigil-@SigilClass(change.Sigil)">@change.Sigil</span> @change.Path
                                                    @if (change.Added + change.Removed > 0)
                                                    {
                                                        <span class="repl-change-counts"><span class="added">+@change.Added</span> <span class="removed">−@change.Removed</span></span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                        @if (_diffAt == msg && _diffPath is not null)
                                        {
                                            @if (_diff is not null) { <DiffView Diff="@_diff" /> }
                                            else { <p class="form-hint">@(_diffReason ?? "Loading the diff…")</p> }
                                        }
                                    }
                                    @if (msg.Usage is { } usage && UsageLabel(usage) is { Length: > 0 } usageText)
                                    {
                                        <div class="repl-msg-usage">@usageText</div>
                                    }
                                }
                                else
                                {
                                    <div class="repl-msg-text">@msg.Text</div>
                                    @if (msg.Images.Count > 0)
                                    {
                                        <div class="repl-tool-chips">
                                            @foreach (var image in msg.Images) { <span class="tool-call-chip">🖼 @image</span> }
                                        </div>
                                    }
                                }
                            </div>
                            break;
                    }
                }

                @foreach (var req in Broker.GetPending(Current.User, session.SessionId).Where(r => r.Source == ApprovalSource.Repl))
                {
                    <ApprovalCard @key="req.Id" Request="req" ShowSource="false" />
                }

                @if (session.Question is { } question)
                {
                    <QuestionCard @key="question" Question="question"
                                  OnAnswer="answer => ReplService.AnswerQuestion(Current.User, session.Key, answer)" />
                }

                @if (busy && session.Shell is null)
                {
                    var live = session.LiveParts();
                    <div class="repl-msg repl-msg-assistant repl-streaming">
                        <div class="repl-msg-role">Assistant</div>
                        @if (live.Length > 0)
                        {
                            <ReplParts Parts="live" />
                            @if (live[^1] is ReplTextPart) { <span class="repl-cursor">▋</span> }
                        }
                        @if (live.Length == 0 || live[^1] is not ReplTextPart)
                        {
                            <div class="repl-thinking-dots">
                                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="repl-dock">
                <div class="repl-input-area">
                    @if (_attachments.Count > 0 || _attachError is not null)
                    {
                        <div class="repl-attachments">
                            @foreach (var image in _attachments)
                            {
                                <span class="repl-attachment" title="@image.Name">
                                    <img src="@image.DataUrl" alt="" />
                                    <span class="repl-attachment-name">@image.Name</span>
                                    <button class="btn-icon" aria-label="Remove @image.Name" @onclick="() => _attachments.Remove(image)">✕</button>
                                </span>
                            }
                            @if (_attachError is not null) { <span class="form-hint form-hint-error">@_attachError</span> }
                        </div>
                    }
                    @* @bind, not value= with @oninput: only @bind stops each re-render from writing the
                       server's older copy over what's still being typed. *@
                    <textarea class="repl-textarea" @ref="_textarea"
                              data-commands="@CommandsJson(session)"
                              data-mentions="@(session.Cwd is null ? "off" : "on")"
                              @bind="_input" @bind:event="oninput"
                              @onkeydown="OnKeyDown"
                              placeholder="@(busy && session.InputWhileBusy
                                             ? "Add to the reply in progress…"
                                             : "Message fuseraft" + (session.Commands.Count > 0 ? " — / for commands" : "") + (session.Cwd is null ? "" : ", @ for files"))"
                              disabled="@(busy && !session.InputWhileBusy)"
                              rows="3"></textarea>
                    <div class="repl-input-actions">
                        <label class="btn btn-sm repl-attach-btn" title="Attach images (or paste them into the box)">
                            Attach
                            <InputFile id="repl-attach" OnChange="OnImagesChosen" multiple
                                       accept="image/png,image/jpeg,image/gif,image/webp" />
                        </label>
                        @if (busy)
                        {
                            <button class="btn btn-danger" @onclick="Cancel">Stop</button>
                        }
                        @if (!busy || session.InputWhileBusy)
                        {
                            <button class="btn btn-primary" @onclick="Send"
                                    disabled="@(string.IsNullOrWhiteSpace(_input) && _attachments.Count == 0)">
                                Send
                            </button>
                        }
                        <span class="muted small repl-send-hint">Enter to send · Shift+Enter for a new line</span>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<ModelProfile>         _profiles  = [];
    private IReadOnlyList<WireReplSession>      _snapshots = [];
    private string? _pageError;
    private string  _workspace       = "";
    private string? _activeSessionId;
    private string  _input           = "";
    private string  _selectedProfileId = "";
    private string  _systemPrompt    = "";
    private bool    _starting        = false;
    private string? _panel;
    private string  _modelQuery = "";
    private IReadOnlyList<string>? _models;
    private string? _modelsError;
    private string? _diffPath;
    private ReplMessage? _diffAt;
    private string? _diff;
    private string? _diffReason;
    private readonly List<ReplImage> _attachments = [];
    private string? _attachError;
    private ElementReference _textarea;
    private string? _composerFor;
    private int     _copiedSeq;
    private DotNetObjectReference<Repl>? _self;
    private (IReadOnlyList<ReplCommand> For, string Json) _commandsJson = ([], "[]");
    private bool    _showPicker;
    private string? _missingWorkspace;
    private string  _toolsQuery      = "";

    protected override async Task OnInitializedAsync()
    {
        _profiles  = await ProfileService.ListAsync();
        _workspace = WorkspaceService.Current;
        await RefreshSnapshotsAsync();

        if (_profiles.Count > 0)
            _selectedProfileId = _profiles[0].Id;

        // Re-attach to any session left open from a previous page visit.
        _activeSessionId = ReplService.GetSessions(Current.User).FirstOrDefault()?.Key;

        if (RendererInfo.IsInteractive)
        {
            ReplService.SessionChanged += OnSessionChanged;
            Broker.PendingChanged      += OnPendingChanged;
        }
    }

    private async Task RefreshSnapshotsAsync()
    {
        try
        {
            _snapshots = await ReplService.ListSnapshotsAsync(Current.User);
        }
        catch (FuseraftCliException ex)
        {
            _snapshots = [];
            _pageError = $"Couldn't list past chats: {ex.Message}";
        }
    }

    private void OnPendingChanged() => InvokeAsync(StateHasChanged);

    private void OnSessionChanged(string sessionId)
    {
        if (sessionId != _activeSessionId) return;
        InvokeAsync(async () =>
        {
            // Session was removed (process exited or /exit sent) — go back to new-session view.
            if (ReplService.GetSession(Current.User, sessionId) is null)
            {
                _activeSessionId = null;
                await RefreshSnapshotsAsync();
            }
            StateHasChanged();
        });
    }

    private void OnDirSelected(string path)
    {
        _workspace        = path;
        _showPicker       = false;
        _missingWorkspace = null;
    }

    private async Task StartSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedProfileId)) return;
        _pageError        = null;
        _missingWorkspace = null;
        var workspace = _workspace.Trim();
        if (workspace.Length > 0 && !Directory.Exists(workspace))
        {
            if (!Path.IsPathFullyQualified(workspace))
                _pageError = $"Use a full path for the workspace, such as {Access.DefaultDirectory}.";
            else if (!Access.Allows(workspace))
                _pageError = $"{workspace} is outside the folders you may work in.";
            else
                _missingWorkspace = Path.GetFullPath(workspace);
            return;
        }
        await StartAsync();
    }

    private async Task CreateWorkspaceAndStartAsync()
    {
        if (_missingWorkspace is not { } path) return;
        try
        {
            Directory.CreateDirectory(path);
        }
        catch (Exception ex)
        {
            _pageError = $"Couldn't create {path}: {ex.Message}";
            return;
        }
        _workspace        = path;
        _missingWorkspace = null;
        await StartAsync();
    }

    private async Task StartAsync()
    {
        _starting  = true;
        StateHasChanged();
        try
        {
            WorkspaceService.Set(_workspace);
            _activeSessionId = await ReplService.CreateSessionAsync(Current.User, _selectedProfileId, _systemPrompt, _workspace);
        }
        catch (Exception ex)
        {
            _activeSessionId = null;
            _pageError       = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task ResumeSnapshotAsync(string snapshotId)
    {
        _pageError = null;
        try
        {
            _activeSessionId = await ReplService.ResumeSnapshotAsync(Current.User, snapshotId);
            await RefreshSnapshotsAsync();
        }
        catch (Exception ex)
        {
            _pageError = ex.Message;
        }
    }

    private void Send()
    {
        var text = _input.Trim();
        if ((string.IsNullOrEmpty(text) && _attachments.Count == 0) || _activeSessionId is null) return;
        _input = "";
        var images = _attachments.ToList();
        _attachments.Clear();
        _attachError = null;
        ReplService.SendMessage(Current.User, _activeSessionId, text, images);
    }

    private void SendNow(string text)
    {
        if (_activeSessionId is not null) ReplService.SendMessage(Current.User, _activeSessionId, text);
    }

    private async Task TogglePanel(string panel)
    {
        _panel = _panel == panel ? null : panel;
        if (_panel == "model" && _models is null) await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        _modelsError = null;
        var session  = ReplService.GetSession(Current.User, _activeSessionId!);
        var profile  = _profiles.FirstOrDefault(p => p.Id == session?.ProfileId);
        if (profile is null)
        {
            _models      = [];
            _modelsError = "This chat's profile is gone, so its models can't be listed. Type a model ID instead.";
            return;
        }
        try
        {
            _models = await Catalog.ListAsync(profile);
        }
        catch (FuseraftCliException ex)
        {
            _models      = [];
            _modelsError = ex.Message;
        }
    }

    private void SwitchModel(string model)
    {
        model = model.Trim();
        if (model.Length == 0 || _activeSessionId is null) return;
        _panel      = null;
        _modelQuery = "";
        ReplService.SendMessage(Current.User, _activeSessionId, $"/model {model}");
    }

    private void OnModelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SwitchModel(_modelQuery);
    }

    /// <summary>Shows <paramref name="path"/>'s diff under <paramref name="at"/>'s changes, or in the Changes panel when null; again hides it.</summary>
    private async Task ShowDiffAsync(string path, ReplMessage? at)
    {
        if (_diffPath == path && _diffAt == at) { _diffPath = null; return; }
        _diffPath   = path;
        _diffAt     = at;
        _diff       = null;
        _diffReason = null;
        var cwd = ReplService.GetSession(Current.User, _activeSessionId!)?.Cwd;
        if (cwd is null) { _diffReason = "This chat has no workspace to compare in."; return; }
        StateHasChanged();
        var (diff, reason) = await WorkspaceFiles.DiffAsync(cwd, path);
        if (_diffPath != path || _diffAt != at) return;
        _diff       = diff;
        _diffReason = reason;
    }

    private static string SigilClass(string sigil) => sigil switch { "A" => "added", "D" => "removed", _ => "changed" };

    private static string LastTool(string running) => running.Split(" → ")[^1];

    private static string ContextLabel(ReplStatusLine s) =>
        $"{s.Context * 100:0}% context" + (s.Input + s.Output > 0 ? $" · {Tokens(s.Input + s.Output)} tokens" : "");

    private static string ContextTitle(ReplStatusLine s) =>
        $"Context window {s.Context * 100:0.#}% full" + (s.Level == "clear" ? "" : s.Level == "near" ? ", nearing auto-compaction" : ", compacting") +
        $". This chat so far: {s.Input:N0} input tokens ({s.Cached:N0} cached), {s.Output:N0} output." +
        (s.Modes.Count > 0 ? $" Modes: {string.Join(", ", s.Modes)}." : "");

    private static string Tokens(long n) => n >= 1_000_000 ? $"{n / 1_000_000.0:0.#}M" : n >= 1_000 ? $"{n / 1_000.0:0.#}k" : n.ToString();

    private static string UsageLabel(ReplUsage u)
    {
        if (u.Input is null && u.Output is null) return "";
        var parts = new List<string>();
        if (u.Input is { } i)  parts.Add($"{Tokens(i)} in" + (u.Cached is > 0 ? $" ({u.Cached * 100 / Math.Max(1, i):0}% cached)" : ""));
        if (u.Output is { } o) parts.Add($"{Tokens(o)} out");
        if (u.Elapsed is { } e) parts.Add(e.TotalSeconds < 60 ? $"{e.TotalSeconds:0.0} s" : $"{(int)e.TotalMinutes} min {e.Seconds} s");
        return string.Join(" · ", parts);
    }

    private static IEnumerable<(string Label, string Prompt)> Starters(ActiveReplSession s)
    {
        if (s.Cwd is null)
        {
            yield return ("Explain a concept", "Explain ");
            yield break;
        }
        yield return ("Explain this project", "Give me a tour of this project: what it does, how it's organized, and where to start reading.");
        if (Directory.Exists(Path.Combine(s.Cwd, ".git")))
            yield return ("Review my changes", "Review my uncommitted changes. Point out bugs, risks and anything unfinished.");
        yield return ("Find a bug to fix", "Look for a real bug in this code, explain it, and propose a fix before changing anything.");
        yield return ("Write tests", "Find the most important untested code here and suggest tests for it.");
    }

    private WireReplSession? LastChatHere(ActiveReplSession s) =>
        _snapshots.FirstOrDefault(snap => snap.SessionId != s.SessionId && snap.TurnIndex > 0
            && string.Equals(snap.Cwd.TrimEnd('/'), (s.Cwd ?? "").TrimEnd('/'), StringComparison.Ordinal));

    private async Task ContinueAsync(string sessionId)
    {
        CloseSession();
        await ResumeSnapshotAsync(sessionId);
    }

    private async Task ExportAsync()
    {
        if (_activeSessionId is null || ReplService.Export(Current.User, _activeSessionId) is not { } markdown) return;
        var id = ReplService.GetSession(Current.User, _activeSessionId)?.SessionId ?? "chat";
        await JS.InvokeVoidAsync("fuseraftChat.download", $"fuseraft-chat-{id}.md", markdown);
    }

    private const int  MaxImages     = 4;
    private const long MaxImageBytes = 5 * 1024 * 1024;

    private async Task OnImagesChosen(InputFileChangeEventArgs e)
    {
        _attachError = null;
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (_attachments.Count >= MaxImages) { _attachError = $"Up to {MaxImages} images per message."; break; }
            if (!file.ContentType.StartsWith("image/")) { _attachError = $"{file.Name} isn't an image."; continue; }
            if (file.Size > MaxImageBytes) { _attachError = $"{file.Name} is over 5 MB."; continue; }
            try
            {
                using var stream = file.OpenReadStream(MaxImageBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                var name = string.IsNullOrWhiteSpace(file.Name) || file.Name == "image.png" ? $"pasted-{_attachments.Count + 1}.png" : file.Name;
                _attachments.Add(new ReplImage(name, $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}"));
            }
            catch (Exception ex)
            {
                _attachError = $"Couldn't read {file.Name}: {ex.Message}";
            }
        }
    }

    private string CommandsJson(ActiveReplSession s)
    {
        if (!ReferenceEquals(_commandsJson.For, s.Commands))
            _commandsJson = (s.Commands, JsonSerializer.Serialize(s.Commands.Select(c => new { u = c.Usage, d = c.Description })));
        return _commandsJson.Json;
    }

    /// <summary>Files and folders in the chat's workspace for an <c>@</c> mention, from the composer's menu.</summary>
    [JSInvokable]
    public IReadOnlyList<string> SuggestFiles(string query) =>
        _activeSessionId is not null && ReplService.GetSession(Current.User, _activeSessionId)?.Cwd is { } cwd
            ? WorkspaceFiles.Suggest(cwd, query)
            : [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || _activeSessionId is null) { _composerFor = null; return; }
        if (ReplService.GetSession(Current.User, _activeSessionId) is not { } session) return;
        if (_composerFor != session.Key)
        {
            _composerFor = session.Key;
            _self ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("fuseraftChat.attach", _textarea, _self); } catch (JSException) { }
        }
        if (session.CopySeq != _copiedSeq)
        {
            _copiedSeq = session.CopySeq;
            if (session.CopyText is { } text)
                try { await JS.InvokeVoidAsync("fuseraftChat.copy", text); } catch (JSException) { }
        }
    }

    private void ToggleTool(ToolSwitches.Toggle t) =>
        ChangeTools(t.On ? "enable" : "disable", t.Tool ?? t.Category);

    private void ChangeTools(string action, string? name = null)
    {
        if (_activeSessionId is not null) ReplService.ChangeTools(Current.User, _activeSessionId, action, name);
    }

    // What the model is offered: tools switched on in a category that's on, and nothing safe mode or a restriction holds back.
    private static int ActiveCount(WireChatTools tools) => tools.Categories
        .Where(c => c.Enabled && c.Blocked is null)
        .Sum(c => (c.Tools ?? []).Count(t => t.Enabled && t.Blocked is null));

    private void Cancel() => ReplService.CancelSession(Current.User, _activeSessionId!);

    private void Clear() => ReplService.ClearSession(Current.User, _activeSessionId!);

    private void CloseSession()
    {
        var id = _activeSessionId;
        _activeSessionId = null;
        _panel           = null;
        _models          = null;
        _diffPath        = null;
        _attachments.Clear();
        if (id is not null)
            ReplService.CloseSession(Current.User, id);
    }

    // app.js keeps the newline out of the box and holds back the Enter that ends an IME composition.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.AltKey)
            Send();
    }

    private static string Truncate(string s, int max) =>
        s.ReplaceLineEndings(" ") is var flat && flat.Length <= max ? flat : flat[..max] + "…";

    public void Dispose()
    {
        _self?.Dispose();
        ReplService.SessionChanged -= OnSessionChanged;
        Broker.PendingChanged      -= OnPendingChanged;
    }
