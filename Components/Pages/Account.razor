@page "/account"
@inject CurrentUser Current
@inject UserStore Users
@inject IOptions<AuthOptions> Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IOptions<EmailOptions> Email
@inject IOptions<WebOptions> Web
@inject EmailConfirmation Confirmation
@inject IEmailSender Sender
@inject ILogger<Account> Logger
@using Microsoft.Extensions.Options
@using fuseraft.Web.Services.Email

<PageTitle>Account — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Account</h1>
    <p class="muted">Signed in as <strong>@Current.User.UserName</strong>@(Current.User.IsAdmin ? " (admin)" : "").</p>
</div>

<div class="card" style="max-width:560px">
    <div class="card-body">
        <div class="form-group">
            <div class="form-label">fuseraft home</div>
            <code>@Current.User.Home</code>
            <div class="form-hint">Your sessions, chats, memory, schedule and model profiles live here.</div>
        </div>
        <div class="form-group">
            <div class="form-label">Workspaces</div>
            @if (Current.User.IsAdmin)
            {
                <span class="muted">Admins can work anywhere.</span>
            }
            else
            {
                @foreach (var root in Current.User.WorkspaceRoots)
                {
                    <div><code>@root</code></div>
                }
            }
        </div>
    </div>
</div>

<h2 class="section-title">Notifications</h2>
<div class="card" style="max-width:560px">
    <div class="card-body">
        @if (_notify is null)
        {
            <span class="muted">Loading…</span>
        }
        else
        {
            <div class="form-group">
                <div class="form-label">Desktop notifications</div>
                @if (!_notify.Supported)
                {
                    <span class="muted">This browser can't show them.</span>
                }
                else if (!_notify.Secure)
                {
                    <span class="muted">Browsers show them only for sites served over HTTPS (or localhost).</span>
                }
                else if (_notify.Permission == "denied")
                {
                    <span class="muted">Blocked for this site. Allow notifications in your browser's site settings, then reload.</span>
                }
                else if (_notify.Desktop)
                {
                    <button class="btn btn-sm" @onclick="() => SetAsync(nameof(NotifyState.Desktop), false)">Turn off</button>
                }
                else
                {
                    <button class="btn btn-sm btn-primary" @onclick="EnableDesktopAsync">Turn on</button>
                }
                <div class="form-hint">Shown while you're in another tab or app. In this tab you'll get a note in the corner instead.</div>
            </div>
            <div class="form-group">
                <div class="form-label">Tell me when</div>
                <div class="notify-options">
                    <label><input type="checkbox" checked="@_notify.Attention" @onchange="e => SetAsync(nameof(NotifyState.Attention), e.Value)" /> something needs my approval or answer</label>
                    <label><input type="checkbox" checked="@_notify.Results" @onchange="e => SetAsync(nameof(NotifyState.Results), e.Value)" /> a session or daemon task finishes or fails</label>
                    <label><input type="checkbox" checked="@_notify.Replies" @onchange="e => SetAsync(nameof(NotifyState.Replies), e.Value)" /> a chat replies</label>
                </div>
                <div class="form-hint">These settings are kept in this browser.</div>
            </div>
        }
    </div>
</div>

<h2 class="section-title">Email</h2>
<div class="card" style="max-width:560px">
    <div class="card-body">
        @if (!Email.Value.Enabled)
        {
            <span class="muted">Email isn't set up on this server.</span>
            @if (Current.User.IsAdmin)
            {
                <div class="form-hint">Set <code>Fuseraft:Email</code> to an SMTP server to send notification emails. See the Notifications guide.</div>
            }
        }
        else
        {
            @if (_emailMessage is not null) { <div class="form-hint">@_emailMessage</div> }
            @if (_emailError is not null) { <div class="error-banner">@_emailError</div> }
            <div class="form-group">
                <div class="form-label">Address</div>
                @if (Me.Email is { } address)
                {
                    <div>Notifications go to <strong>@address</strong>.</div>
                    <div class="email-actions">
                        <button class="btn btn-sm" @onclick="SendTestAsync" disabled="@_sending">Send a test email</button>
                        <button class="btn btn-sm" @onclick="() => SetAddress(null)">Stop emailing me</button>
                    </div>
                }
                else
                {
                    <span class="muted">No address yet.</span>
                }
                @foreach (var sso in SignOnEmails)
                {
                    <div class="email-actions">
                        <button class="btn btn-sm" @onclick="() => SetAddress(sso)">Use @sso</button>
                        <span class="form-hint">from your sign-on</span>
                    </div>
                }
            </div>
            <div class="form-group">
                <label class="form-label" for="new-email">@(Me.Email is null ? "Add an address" : "Change it")</label>
                <input class="input" id="new-email" type="email" autocomplete="email" @bind="_newEmail" />
                <div class="form-hint">We'll email a link to confirm it's yours. It works for 24 hours.</div>
                <button class="btn btn-sm btn-primary" style="margin-top:8px" @onclick="SendConfirmationAsync" disabled="@_sending">Send link</button>
            </div>
            <div class="form-group">
                <div class="form-label">Email me when</div>
                <div class="notify-options">
                    <label><input type="checkbox" checked="@Me.EmailChoices.Attention" @onchange="e => SetChoice(c => c.Attention = e.Value is true)" /> something has waited @WaitLabel for my approval or answer</label>
                    <label><input type="checkbox" checked="@Me.EmailChoices.Results" @onchange="e => SetChoice(c => c.Results = e.Value is true)" /> a session or daemon task finishes or fails</label>
                </div>
                <div class="form-hint">Chat replies are never emailed. What happens close together arrives as one email.</div>
            </div>
        }
    </div>
</div>

@if (Auth.Value.LocalAccounts)
{
    <h2 class="section-title">Change password</h2>
    <div class="card" style="max-width:560px">
        <div class="card-body">
            @if (_message is not null) { <div class="form-hint">@_message</div> }
            @if (_error is not null) { <div class="error-banner">@_error</div> }
            @if (Current.User.PasswordHash is not null)
            {
                <div class="form-group">
                    <label class="form-label">Current password</label>
                    <input class="input" type="password" autocomplete="current-password" @bind="_current" />
                </div>
            }
            <div class="form-group">
                <label class="form-label">New password</label>
                <input class="input" type="password" autocomplete="new-password" @bind="_new" />
                <div class="form-hint">At least @PasswordHashing.MinimumLength characters. Changing it signs you out everywhere.</div>
            </div>
            <div class="form-group">
                <label class="form-label">New password again</label>
                <input class="input" type="password" autocomplete="new-password" @bind="_confirm" />
            </div>
            <button class="btn btn-primary" @onclick="ChangePassword">Change password</button>
        </div>
    </div>
}

@if (Auth.Value.Oidc.Enabled)
{
    <h2 class="section-title">Single sign-on</h2>
    <div class="card" style="max-width:560px">
        <div class="card-body">
            @if (Current.User.Logins.Count == 0)
            {
                <p class="muted">No sign-on identity is linked.</p>
            }
            @foreach (var login in Current.User.Logins)
            {
                <div><code>@(login.Email ?? login.Subject)</code> <span class="muted">from @login.Issuer</span></div>
            }
            <a class="btn" style="margin-top:12px" href="account/oidc?link=true&returnUrl=%2Faccount" data-enhance-nav="false">
                Link @Auth.Value.Oidc.DisplayName
            </a>
        </div>
    </div>
}

@code {
    private string _current = "", _new = "", _confirm = "";
    private string? _error, _message;
    private NotifyState? _notify;
    private string _newEmail = "";
    private string? _emailMessage, _emailError;
    private bool _sending;

    [SupplyParameterFromQuery(Name = "email")] private string? EmailResult { get; set; }

    // The circuit's copy of the account doesn't see changes saved since sign-in.
    private WebUser Me => Users.Find(Current.User.Id) ?? Current.User;

    private IEnumerable<string> SignOnEmails => Me.Logins
        .Select(l => EmailConfirmation.Normalize(l.Email)).OfType<string>()
        .Where(e => !string.Equals(e, Me.Email, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase);

    private string WaitLabel => Email.Value.WaitMinutes switch
    {
        <= 0 => "at all",
        1    => "a minute",
        var m => $"{m} minutes",
    };

    protected override void OnInitialized()
    {
        _emailMessage = EmailResult == "confirmed" ? "Your address is confirmed." : null;
        _emailError   = EmailResult == "invalid" ? "That link is used, expired or for another account. Send yourself a new one." : null;
    }

    private void SetAddress(string? address)
    {
        _emailError = null;
        Users.Update(Me.Id, u => u.Email = address);
        _emailMessage = address is null ? "You won't get notification emails." : $"Notifications now go to {address}.";
    }

    private void SetChoice(Action<EmailChoices> change) => Users.Update(Me.Id, u => change(u.EmailChoices));

    private async Task SendConfirmationAsync()
    {
        _emailMessage = _emailError = null;
        if (EmailConfirmation.Normalize(_newEmail) is not { } address) { _emailError = "That isn't an email address."; return; }
        if (!Confirmation.TryReserve(Me)) { _emailError = "A link was just sent. Wait a minute before asking for another."; return; }

        var link = $"{(Web.Value.PublicUrl?.TrimEnd('/') ?? Nav.BaseUri.TrimEnd('/'))}/account/email/confirm?token={Uri.EscapeDataString(Confirmation.Token(Me, address))}";
        await SendAsync(address, "Confirm your email for fuseraft",
            $"Someone signed in as {Me.UserName} asked to get fuseraft notifications at this address.\n\n" +
            $"To confirm, open this link while signed in:\n{link}\n\nIt works for 24 hours. If this wasn't you, ignore this email.\n",
            $"Sent a link to {address}. Open it while signed in here.");
        if (_emailError is null) _newEmail = "";
    }

    private Task SendTestAsync() => Me.Email is { } to
        ? SendAsync(to, "Test email from fuseraft", "Notification emails from fuseraft will look like this.\n", $"Sent a test email to {to}.")
        : Task.CompletedTask;

    private async Task SendAsync(string to, string subject, string body, string sent)
    {
        _sending = true;
        try
        {
            await Sender.SendAsync(to, subject, body);
            _emailMessage = sent;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Couldn't email {User}", Me.UserName);
            _emailError = Me.IsAdmin
                ? $"Couldn't send it: {ex.Message}"
                : "Couldn't send it. Ask an admin to check the server's email settings.";
        }
        finally { _sending = false; }
    }

    private sealed record NotifyState(bool Desktop, bool Attention, bool Results, bool Replies, bool Supported, bool Secure, string Permission);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _notify = await JS.InvokeAsync<NotifyState>("fuseraftNotify.state");
        StateHasChanged();
    }

    private async Task EnableDesktopAsync() =>
        _notify = await JS.InvokeAsync<NotifyState>("fuseraftNotify.enableDesktop");

    private async Task SetAsync(string name, object? value) =>
        _notify = await JS.InvokeAsync<NotifyState>("fuseraftNotify.set", char.ToLowerInvariant(name[0]) + name[1..], value is true);

    private void ChangePassword()
    {
        _error = _message = null;
        var user = Current.User;
        if (user.PasswordHash is not null && !PasswordHashing.Verify(_current, user.PasswordHash)) { _error = "Your current password is wrong."; return; }
        if (_new != _confirm) { _error = "The new passwords don't match."; return; }
        try
        {
            Users.SetPassword(user.Id, _new);
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (ArgumentException ex) { _error = ex.Message; }
    }
}
